{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:golden_chestplate.player",
      "item": {
        "minecraft:golden_chestplate": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/gold_1",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.player.armor.chestplate",
        "minimal": "geometry.sma.minimal.chestplate"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "animate": [
          "offset"
        ]
      },
      "animations": {
        "offset": "animation.armor.chestplate.offset"
      },
      "render_controllers": [
        "controller.render.sma_armor_chest"
      ]
    }
  }
}
